{
  "name": "python-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pyodide:fetch": "node scripts/fetch-pyodide.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "check:py310": "python3 scripts/check-py310.py scripts/py310/snippets.json",
    "check:py310-run": "python3 scripts/py310/run-cases.py",
    "check:quotes": "node scripts/check-quotes.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-production-hooks.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pyodide": "314.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
